# ─── AWS Configuration ────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=<your-aws-account-id>

# ─── Amazon Cognito ───────────────────────────────────────────────────────
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=<your-user-pool-id>
COGNITO_CLIENT_ID=<your-app-client-id>
COGNITO_DOMAIN=<your-cognito-domain>

# ─── Amazon DynamoDB ──────────────────────────────────────────────────────
DYNAMODB_TABLE_USERS=aisss-users
DYNAMODB_TABLE_CONVERSATIONS=aisss-conversations
DYNAMODB_TABLE_MESSAGES=aisss-messages
DYNAMODB_TABLE_CACHE=aisss-response-cache
DYNAMODB_TABLE_ANALYTICS=aisss-analytics
DYNAMODB_TABLE_FEEDBACK=aisss-feedback
DYNAMODB_TABLE_AUDIT=aisss-audit-logs
DYNAMODB_TABLE_KNOWLEDGE=aisss-knowledge-base

# ─── Amazon Bedrock ───────────────────────────────────────────────────────
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ROUTINE=amazon.nova-lite-v1:0
BEDROCK_MODEL_COMPLEX=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_GUARDRAIL_ID=<your-guardrail-id>
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ─── Amazon SQS ───────────────────────────────────────────────────────────
SQS_CHAT_QUEUE_URL=<your-sqs-queue-url>
SQS_DLQ_URL=<your-dlq-url>

# ─── Amazon SES ───────────────────────────────────────────────────────────
SES_FROM_EMAIL=noreply@<your-domain>
SES_REGION=us-east-1

# ─── Amazon SNS ───────────────────────────────────────────────────────────
SNS_ALERTS_TOPIC_ARN=<your-sns-topic-arn>

# ─── Application ──────────────────────────────────────────────────────────
APP_NAME=AI-Powered Student Support System
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Frontend (Vite public vars) ──────────────────────────────────────────
VITE_APP_NAME=AI-Powered Student Support System
VITE_API_URL=http://localhost:3000
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=<your-user-pool-id>
VITE_COGNITO_CLIENT_ID=<your-app-client-id>

# ─── Local Development (Docker / LocalStack) ──────────────────────────────
DYNAMODB_ENDPOINT=http://localhost:4566
COGNITO_ENDPOINT=http://localhost:4566
SQS_ENDPOINT=http://localhost:4566
SES_ENDPOINT=http://localhost:4566
