{
  "name": "@aisss/backend",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Student Support System — Backend Lambda functions",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && npm run bundle",
    "bundle": "node scripts/bundle.js",
    "dev": "node --loader ts-node/esm --no-warnings src/dev-server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy:dev": "node scripts/deploy.js dev",
    "deploy:staging": "node scripts/deploy.js staging",
    "deploy:prod": "node scripts/deploy.js prod",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent": "^3.717.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.717.0",
    "@aws-sdk/client-bedrock-runtime": "^3.717.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.717.0",
    "@aws-sdk/client-dynamodb": "^3.717.0",
    "@aws-sdk/client-lambda": "^3.717.0",
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0",
    "@aws-sdk/client-ses": "^3.717.0",
    "@aws-sdk/client-sns": "^3.717.0",
    "@aws-sdk/client-sqs": "^3.717.0",
    "@aws-sdk/lib-dynamodb": "^3.717.0",
    "@aws-sdk/util-dynamodb": "^3.717.0",
    "jose": "^5.9.6",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.10.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^2.1.8",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
