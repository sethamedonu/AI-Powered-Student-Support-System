{
  "info": {
    "name": "AI-Powered Student Support System API",
    "_postman_id": "aisss-api-collection-v1",
    "description": "Complete API test collection for AISSS — covers auth, chat, conversations, feedback, admin, and health endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "{{BASE_URL}}" },
    { "key": "accessToken", "value": "" },
    { "key": "conversationId", "value": "" },
    { "key": "feedbackId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 503', () => {",
                  "  pm.expect([200, 503]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Response has status field', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.status).to.be.oneOf(['healthy', 'degraded']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 or 409', () => {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{TEST_EMAIL}}\",\n  \"password\": \"{{TEST_PASSWORD}}\",\n  \"givenName\": \"Test\",\n  \"familyName\": \"Student\",\n  \"studentId\": \"STU-001\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns tokens', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.tokens.accessToken).to.be.a('string');",
                  "  pm.collectionVariables.set('accessToken', body.data.tokens.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{TEST_EMAIL}}\",\n  \"password\": \"{{TEST_PASSWORD}}\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/login — invalid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"wrong@test.com\",\n  \"password\": \"WrongPass999!\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/forgot-password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{TEST_EMAIL}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "POST /chat/message",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns answer and conversationId', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.answer).to.be.a('string');",
                  "  pm.expect(body.data.conversationId).to.be.a('string');",
                  "  pm.collectionVariables.set('conversationId', body.data.conversationId);",
                  "});",
                  "pm.test('Has cacheStatus field', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.cacheStatus).to.be.oneOf(['hit', 'miss']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/chat/message",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What are the tuition fees for undergraduate programs?\",\n  \"category\": \"tuition\"\n}"
            }
          }
        },
        {
          "name": "POST /chat/message — continue conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Same conversationId', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.conversationId).to.equal(pm.collectionVariables.get('conversationId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/chat/message",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Are there any scholarships available?\",\n  \"conversationId\": \"{{conversationId}}\",\n  \"category\": \"scholarships\"\n}"
            }
          }
        },
        {
          "name": "POST /chat/message — unauthenticated",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/chat/message",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What are the tuition fees?\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Conversations",
      "item": [
        {
          "name": "GET /conversations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns paginated items', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.items).to.be.an('array');",
                  "  pm.expect(body.data.count).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/conversations?limit=10"
          }
        },
        {
          "name": "GET /conversations/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns conversation and messages', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.conversation).to.be.an('object');",
                  "  pm.expect(body.data.messages.items).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/conversations/{{conversationId}}"
          }
        },
        {
          "name": "DELETE /conversations/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns deleted flag', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.deleted).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/conversations/{{conversationId}}"
          }
        }
      ]
    },
    {
      "name": "Feedback",
      "item": [
        {
          "name": "POST /feedback",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Returns feedbackId', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.feedbackId).to.be.a('string');",
                  "  pm.collectionVariables.set('feedbackId', body.data.feedbackId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/feedback",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"category\": \"general\",\n  \"comment\": \"The AI assistant gave a very helpful and accurate response!\"\n}"
            }
          }
        },
        {
          "name": "POST /feedback — invalid rating",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/feedback",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 10,\n  \"category\": \"general\",\n  \"comment\": \"Too short\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "GET /admin/stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 403', () => {",
                  "  pm.expect([200, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/admin/stats"
          }
        },
        {
          "name": "GET /admin/users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 403', () => {",
                  "  pm.expect([200, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/admin/users?limit=10"
          }
        },
        {
          "name": "GET /admin/analytics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 403', () => {",
                  "  pm.expect([200, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/admin/analytics?period=week"
          }
        },
        {
          "name": "GET /admin/feedback",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 403', () => {",
                  "  pm.expect([200, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/admin/feedback?limit=10"
          }
        }
      ]
    }
  ]
}
